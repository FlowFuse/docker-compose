DOMAIN=
APPLICATION_DOMAIN=""

### TLS certificates configuration
TLS_ENABLED="" # Do not add any value here if you want to keep TLS disabled
TLS_CERTIFICATE=""
TLS_KEY=""
APP_TLS_CERTIFICATE=""
APP_TLS_KEY=""

### Database configuration
### Fill only if you want to use an external database (https://flowfuse.com/docs/install/docker/#how-to-use-external-database-server%3F), leave empty otherwise
DB_HOST=""
DB_USER=""
DB_PASSWORD=""

### Email configuration
EMAIL_ENABLED=false
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_SECURE=""
EMAIL_USER=""
EMAIL_PASSWORD=""

### Docker Driver options
DOCKER_DRIVER_PRIVATE_CA_PATH=""

### NPM Registry options
NPM_PASSWORD=""

### Assistant options
ASSISTANT_URL="https://expert.flowfuse.com/v1/openai"
ASSISTANT_TOKEN=""

### Expert options
EXPERT_URL="https://expert.flowfuse.com/v4/expert"
EXPERT_TOKEN=""
EXPERT_BROKER_SERVER="expert-broker.flowfuse.com"

### Team broker admin API credentials (used to bootstrap the local EMQX and to
### provision the Expert chat bridge). Both sides read the same values.
### Leave empty to use defaults
BROKER_API_KEY=""
BROKER_API_SECRET=""

### Time-series databases (Enterprise)
### One QuestDB server per team. Start the stack with `--profile timeseries` as well.
### Needs a wildcard DNS entry for *.ts.${DOMAIN}. See https://flowfuse.com/docs/install/timeseries/
TIMESERIES_ENABLED=false
# QuestDB image used for new servers
TIMESERIES_IMAGE="questdb/questdb:9.0.1"
# Host port PgBouncer is published on. Devices query their team's server through it
TIMESERIES_PGWIRE_PORT=5432
# Let team owners connect their own QuestDB server on a private network (leave false on shared platforms)
TIMESERIES_ALLOW_PRIVATE_NETWORKS=false
